module(
    name = "rpcpio",
    version = "0.1.0",
    compatibility_level = 1,
    bazel_compatibility = [">=8.7.0"],
)

# ── Core transport ────────────────────────────────────────────────────────────
# Provides @nghttp2-asio//:nghttp2_asio: dloman/nghttp2-asio (externally driven
# io_context/executor, trailers, GOAWAY) on libnghttp2 and OpenSSL.
bazel_dep(name = "nghttp2-asio", version = "0.0.91")
bazel_dep(name = "boost.asio", version = "1.87.0")

# nghttp2-asio 0.0.91 is not published to a registry. Overrides only apply when
# rpcpio is the root module; consumers must supply their own.
git_override(
    module_name = "nghttp2-asio",
    commit = "568af6f9f36539c19ec6477d7475cd2bda1df131",
    remote = "https://github.com/dloman/nghttp2-asio.git",
)

# ── Protobuf runtime and compiler ────────────────────────────────────────────
bazel_dep(name = "protobuf", version = "27.3")
bazel_dep(name = "rules_proto", version = "6.0.0")

# ── Optional compression ──────────────────────────────────────────────────────
bazel_dep(name = "zlib", version = "1.3.1.bcr.3")

# ── Test infrastructure ───────────────────────────────────────────────────────
bazel_dep(name = "googletest", version = "1.14.0", dev_dependency = True)
bazel_dep(name = "rules_fuzzing", version = "0.5.2", dev_dependency = True)
