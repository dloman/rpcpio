load("@rules_proto//proto:defs.bzl", "proto_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")

package(default_visibility = ["//visibility:private"])

proto_library(
    name = "slow_echo_proto",
    srcs = ["slow_echo.proto"],
)

cc_proto_library(
    name = "slow_echo_cc_proto",
    deps = [":slow_echo_proto"],
)

genrule(
    name = "slow_echo_rpcpio_gen",
    srcs = ["slow_echo.proto"],
    outs = [
        "slow_echo.rpcpio.pb.h",
        "slow_echo.rpcpio.pb.cc",
    ],
    cmd = """
        $(location @protobuf//:protoc) \
            --plugin=protoc-gen-rpcpio=$(location //:rpcpio_cpp_plugin) \
            --rpcpio_out=$(RULEDIR) \
            -I$$(dirname $(location slow_echo.proto)) \
            $(location slow_echo.proto)
    """,
    tools = [
        "@protobuf//:protoc",
        "//:rpcpio_cpp_plugin",
    ],
)

cc_library(
    name = "slow_echo_rpcpio",
    srcs = [":slow_echo_rpcpio_gen"],
    hdrs = ["slow_echo.rpcpio.pb.h"],
    copts = ["-std=c++20"],
    deps = [
        ":slow_echo_cc_proto",
        "//:rpcpio_runtime",
    ],
)

cc_binary(
    name = "slow_echo_server",
    srcs = ["slow_echo_server.cc"],
    copts = ["-std=c++20"],
    deps = [":slow_echo_rpcpio"],
)

cc_binary(
    name = "slow_echo_client",
    srcs = ["slow_echo_client.cc"],
    copts = ["-std=c++20"],
    deps = [":slow_echo_rpcpio"],
)
