load("@rules_proto//proto:defs.bzl", "proto_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")

package(default_visibility = ["//visibility:private"])

# Proto definitions
proto_library(
    name = "helloworld_proto",
    srcs = ["helloworld.proto"],
)

cc_proto_library(
    name = "helloworld_cc_proto",
    deps = [":helloworld_proto"],
)

# Run rpcpio_cpp_plugin to generate typed bindings.
genrule(
    name = "helloworld_rpcpio_gen",
    srcs = ["helloworld.proto"],
    outs = [
        "helloworld.rpcpio.pb.h",
        "helloworld.rpcpio.pb.cc",
    ],
    cmd = """
        $(location @protobuf//:protoc) \
            --plugin=protoc-gen-rpcpio=$(location //:rpcpio_cpp_plugin) \
            --rpcpio_out=$(RULEDIR) \
            -I$$(dirname $(location helloworld.proto)) \
            $(location helloworld.proto)
    """,
    tools = [
        "@protobuf//:protoc",
        "//:rpcpio_cpp_plugin",
    ],
)

# Generated rpcpio bindings library.
cc_library(
    name = "helloworld_rpcpio",
    srcs = [":helloworld_rpcpio_gen"],
    hdrs = ["helloworld.rpcpio.pb.h"],
    copts = ["-std=c++20"],
    deps = [
        ":helloworld_cc_proto",
        "//:rpcpio_runtime",
    ],
)

# Server binary
cc_binary(
    name = "greeter_server",
    srcs = ["greeter_server.cc"],
    copts = ["-std=c++20"],
    deps = [":helloworld_rpcpio"],
)

# Client binary
cc_binary(
    name = "greeter_client",
    srcs = ["greeter_client.cc"],
    copts = ["-std=c++20"],
    deps = [":helloworld_rpcpio"],
)
