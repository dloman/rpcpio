load("@rules_proto//proto:defs.bzl", "proto_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")

package(default_visibility = ["//visibility:private"])

# Proto definitions
proto_library(
    name = "helloworld_proto",
    srcs = ["helloworld.proto"],
)

cc_proto_library(
    name = "helloworld_cc_proto",
    deps = [":helloworld_proto"],
)

# Run asio_grpc_cpp_plugin to generate typed bindings.
genrule(
    name = "helloworld_asio_grpc_gen",
    srcs = ["helloworld.proto"],
    outs = [
        "helloworld.asio_grpc.pb.h",
        "helloworld.asio_grpc.pb.cc",
    ],
    cmd = """
        $(location @protobuf//:protoc) \
            --plugin=protoc-gen-asio-grpc=$(location //:asio_grpc_cpp_plugin) \
            --asio-grpc_out=$(RULEDIR) \
            -I$$(dirname $(location helloworld.proto)) \
            $(location helloworld.proto)
    """,
    tools = [
        "@protobuf//:protoc",
        "//:asio_grpc_cpp_plugin",
    ],
)

# Generated asio_grpc bindings library.
cc_library(
    name = "helloworld_asio_grpc",
    srcs = [":helloworld_asio_grpc_gen"],
    hdrs = ["helloworld.asio_grpc.pb.h"],
    copts = ["-std=c++20"],
    deps = [
        ":helloworld_cc_proto",
        "//:asio_grpc_runtime",
    ],
)

# Server binary
cc_binary(
    name = "greeter_server",
    srcs = ["greeter_server.cc"],
    copts = ["-std=c++20"],
    deps = [":helloworld_asio_grpc"],
)

# Client binary
cc_binary(
    name = "greeter_client",
    srcs = ["greeter_client.cc"],
    copts = ["-std=c++20"],
    deps = [":helloworld_asio_grpc"],
)
