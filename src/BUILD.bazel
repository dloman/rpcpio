package(default_visibility = ["//visibility:public"])

# Full runtime: client + server + protocol primitives.
cc_library(
    name = "rpcpio_runtime",
    deps = [
        "//include:rpcpio_hdrs",
        "//src/client:client",
        "//src/server:server",
        "//src/protocol:protocol",
    ],
)

# Alias used by the root BUILD.
alias(
    name = "rpcpio",
    actual = ":rpcpio_runtime",
)
